#!name = 看剧AI 定向诊断
#!desc = 蓝色标记只证明 HTML 已被小火箭改写；不依赖页面 JS。测试时停用其他看剧模块，测完停用本模块。
#!author = Sizisa
#!system = ios

[Script]
kanju.diag.html = type=http-response,pattern=^https?:\/\/([a-z0-9-]+\.)*(kanju[0-9]*|souju[0-9]*|baipiao)\.(com|ai)(:\d+)?(\/(index\.html|player(/[^?#]*)?|midnight-theater)?)?(\?[^#]*)?$,requires-body=1,script-path=https://raw.githubusercontent.com/Sizisa/Shadowrocket/main/scripts/kanju-diag.js?v=20261004-html1
kanju.diag.api = type=http-response,pattern=^https?:\/\/([a-z0-9-]+\.)*(kanju[0-9]*|souju[0-9]*|baipiao)\.(com|ai)(:\d+)?\/v1\/,requires-body=1,script-path=https://raw.githubusercontent.com/Sizisa/Shadowrocket/main/scripts/kanju-diag.js?v=20261004-html1

[MITM]
# 与去广告模块同步覆盖 kanju/souju 前缀域名及子域。
